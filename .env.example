# ─────────────────────────────────────────────────────────────────────────────
#  transcribe-pipeline — environment template
#
#  Copy this file to `.env` and adjust. Every value is optional; the default
#  shown is what config.js falls back to when the variable is unset.
#
#  `.env` is loaded automatically: src/env.js calls dotenv, and src/server.js
#  imports it first. So `npm start` / `node src/server.js` both pick it up.
#
#  Real environment variables always win over this file (dotenv never
#  overwrites an existing key), so a one-off override needs no edit:
#
#      $env:WHISPER_MODEL='Xenova/whisper-small'; npm.cmd start
#
#  Values are unquoted on purpose — dotenv strips quotes, but keeping them off
#  avoids surprises with the Windows shell.
# ─────────────────────────────────────────────────────────────────────────────


# ── HTTP ─────────────────────────────────────────────────────────────────────

# Port to listen on. 0 picks a random free port.
PORT=3000

# Shared secret for the x-api-key header. EMPTY = authentication disabled,
# which is the right setting for local development only.
API_KEY=


# ── Storage ──────────────────────────────────────────────────────────────────

# Root directory for jobs.db and the uploaded audio. Resolved relative to the
# process working directory, so start the server from the project root.
STORAGE_DIR=storage


# ── Engine ───────────────────────────────────────────────────────────────────

# "whisper" = real model in worker threads.
# "mock"    = deterministic fake segments, no model download. Use for tests.
ENGINE=whisper

# Hugging Face model id. Bigger = more accurate + slower + more RAM.
# Only ONE model per process; every worker thread loads its own copy.
#
#   Xenova/whisper-tiny    ~150 MB   fastest, good for a CPU-only dev machine
#   Xenova/whisper-base    ~290 MB
#   Xenova/whisper-small   ~1.0 GB   the default in the written design
#   Xenova/whisper-medium  ~3.0 GB   needs a GPU to be usable
#
# First run downloads the weights and caches them under the package's .cache.
WHISPER_MODEL=Xenova/whisper-tiny

# Jobs processed in parallel, and worker threads (one model each).
# Memory, not CPU, is the limit: budget ~0.7-1.2 GB per worker for whisper-small.
CONCURRENCY=2


# ── Limits and retries ───────────────────────────────────────────────────────

# Maximum upload size in megabytes. Larger uploads get HTTP 413.
MAX_FILE_MB=500

# Maximum number of jobs waiting in the queue. Beyond this, new uploads get
# HTTP 429 with Retry-After (checked before the body is read).
MAX_QUEUE=100

# Total attempts per job before it is marked failed (dead-letter).
# Transient failures back off exponentially with jitter; corrupt or
# undecodable media fails immediately on attempt 1.
MAX_ATTEMPTS=4

# Seconds per processing chunk. Each finished chunk is checkpointed, so a
# retry resumes here rather than restarting the file.
#
# WARNING: checkpoints are keyed by chunk index, so changing this value for a
# job that already has saved chunks will misalign the resume. Keep it stable.
CHUNK_SECONDS=600


# ── Audio retention ──────────────────────────────────────────────────────────

# Delete the uploaded file as soon as its transcription completes. The
# transcript is the artifact; the audio is not kept afterwards.
#
# Failed jobs always keep their audio, so POST /:id/retry can resume from the
# last checkpoint. Set this to false to keep every upload (useful for demos or
# if you want to re-transcribe without re-uploading).
DELETE_AUDIO_ON_COMPLETE=true


# ── Webhooks ─────────────────────────────────────────────────────────────────

# HMAC-SHA256 key for signing outgoing webhook bodies (x-signature header).
# Empty = webhooks are sent unsigned. Per-request webhook_url is optional.
WEBHOOK_SECRET=


# ── Fixed constants (documented, not configurable) ───────────────────────────
#
#   overlapSeconds = 2   decode overlap either side of each chunk boundary
#   stallSeconds   = 60  heartbeat age after which a job is requeued
#
#   Allowed upload extensions:
#     .wav .mp3 .m4a .flac .ogg .opus .aac .webm .mp4 .mov .aiff
#   Everything is normalized with ffmpeg to 16 kHz mono float32 PCM, so video
#   containers work as long as they carry an audio stream.
